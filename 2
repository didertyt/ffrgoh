    flyEnabled = not flyEnabled
    playToggleSound(flyEnabled)
    createFlyControls(flyEnabled)

    if flyEnabled then
        FlyToggleBtn.Text = "🕊️ ПОЛЕТ: ВКЛ"
        FlyToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
        FlyToggleBtn.BorderColor3 = Color3.fromRGB(200, 100, 255)
        FlyToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        sendNotification("🕊️ Полет включен!")

        flyConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not root or not hum then return end

            hum.PlatformStand = true
            local camCFrame = Camera.CFrame
            local moveDir = Vector3.zero

            if hum.MoveDirection.Magnitude > 0 then
                moveDir = camCFrame.LookVector * (hum.MoveDirection:Dot(camCFrame.LookVector)) + camCFrame.RightVector * (hum.MoveDirection:Dot(camCFrame.RightVector))
                moveDir = moveDir.Unit
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or flyUpPressed then
                moveDir += Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) or flyDownPressed then
                moveDir -= Vector3.new(0, 1, 0)
            end

            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit * flySpeed
            end

            root.AssemblyLinearVelocity = moveDir
            root.CFrame = CFrame.new(root.Position, root.Position + camCFrame.LookVector)
        end)
    else
        FlyToggleBtn.Text = "🕊️ ПОЛЕТ: ВЫКЛ"
        FlyToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 60)
        FlyToggleBtn.BorderColor3 = Color3.fromRGB(130, 60, 180)
        FlyToggleBtn.TextColor3 = Color3.fromRGB(200, 170, 230)
        sendNotification("🕊️ Полет выключен!")

