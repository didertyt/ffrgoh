    if clickFlingConnection then clickFlingConnection:Disconnect() end
    if shiftlockConnection then shiftlockConnection:Disconnect() end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default

    if FlyControlGui then FlyControlGui:Destroy() end
    if ShiftlockGui then ShiftlockGui:Destroy() end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = 16
            hum.UseJumpPower = true
            hum.JumpPower = 50
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end

    ScreenGui:Destroy()
end

