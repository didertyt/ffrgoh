local function startOrbitKillProcess()
    if not selectedFarmTarget then
        sendNotification("⚠️ Сначала выберите цель из списка!")
        return
    end

    if infiniteKillEnabled then
        stopInfiniteKill()
        KillActionBtn.Text = "⚔️ КИЛЛ ЦЕЛИ: ВЫКЛ"
        KillActionBtn.BackgroundColor3 = Color3.fromRGB(150, 20, 60)
    end

    orbitKillEnabled = true
    OrbitActionBtn.Text = "🪐 ОРБИТ КИЛЛ: ВКЛ"
    OrbitActionBtn.BackgroundColor3 = Color3.fromRGB(70, 20, 110)
    OrbitActionBtn.BorderColor3 = Color3.fromRGB(255, 100, 255)
    sendNotification("🪐 Орбит килл запущен!")

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        sendNotification("⚠️ Ваш персонаж не загружен!")
        stopOrbitKill()
        OrbitActionBtn.Text = "🪐 ОРБИТ КИЛЛ: ВЫКЛ"
        OrbitActionBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
        return
    end

    local originalCFrame = root.CFrame

    local noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    local angle = 0
    local orbitRadius = 4  
    local orbitSpeed = 5   

    orbitKillConnection = RunService.RenderStepped:Connect(function(dt)
        if not selectedFarmTarget or not selectedFarmTarget.Parent or not selectedFarmTarget.Character then
            sendNotification("⚠️ Цель вышла из игры. Остановка орбиты...")
            stopOrbitKill()
            noclipConn:Disconnect()

            if char and root and hum and hum.Health > 0 then
                local startTime = tick()
                while tick() - startTime < 2 do
                    if root then
                        root.CFrame = originalCFrame
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                    task.renderStepped:Wait()
                end
            end

            OrbitActionBtn.Text = "🪐 ОРБИТ КИЛЛ: ВЫКЛ"
            OrbitActionBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
            return
        end

        local targetChar = selectedFarmTarget.Character
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")

        if targetRoot and targetHum and targetHum.Health > 0 then
            angle = angle + (orbitSpeed * dt)

            local offsetX = math.cos(angle) * orbitRadius
            local offsetZ = math.sin(angle) * orbitRadius

            local targetPos = targetRoot.Position
            local newPosition = targetPos + Vector3.new(offsetX, 2, offsetZ)

            root.CFrame = CFrame.new(newPosition, targetPos)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    orbitAttackTask = task.spawn(function()
        while orbitKillEnabled do
            local currentCharacter = LocalPlayer.Character
            if currentCharacter then
                local tool = currentCharacter:FindFirstChildOfClass("Tool")
                if tool then
                    pcall(function() tool:Activate() end)
                end
            end
            task.wait(0.2)
        end
    end)
end

local function stopOrbitKillProcess()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local savedCFrame = root and root.CFrame

    stopOrbitKill()
    sendNotification("🛑 Орбит килл выключен. Возврат на точку на 2 сек.")

    if char and root and hum and hum.Health > 0 then
        task.spawn(function()
            local startTime = tick()
            while tick() - startTime < 2 do
                if root then
                    root.CFrame = savedCFrame or root.CFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
                task.renderStepped:Wait()
            end
        end)
    end

    OrbitActionBtn.Text = "🪐 ОРБИТ КИЛЛ: ВЫКЛ"
    OrbitActionBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
end

