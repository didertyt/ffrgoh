local function sendNotification(message: string, duration: number?)
    local notifDuration = duration or 2.5
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(1, 0, 0, 40)
    notif.BackgroundColor3 = Color3.fromRGB(18, 10, 30)
    notif.BackgroundTransparency = 1
    notif.BorderColor3 = Color3.fromRGB(170, 60, 255)
    notif.BorderSizePixel = 1
    notif.ZIndex = 101
    notif.Parent = NotificationContainer

    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 6)
    notifCorner.Parent = notif

    local notifText = Instance.new("TextLabel")
    notifText.Size = UDim2.new(1, -15, 1, 0)
    notifText.Position = UDim2.new(0, 15, 0, 0)
    notifText.BackgroundTransparency = 1
    notifText.ZIndex = 102
    notifText.Text = "🔮 " .. message
    notifText.Font = Enum.Font.GothamBold
    notifText.TextSize = 11
    notifText.TextXAlignment = Enum.TextXAlignment.Left
    notifText.TextColor3 = Color3.fromRGB(230, 200, 255)
    notifText.Parent = notif

    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundTransparency = 0.3}):Play()

    task.delay(notifDuration, function()
        if notif and notif.Parent then
            local tweenOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {BackgroundTransparency = 1})
            tweenOut:Play()
            tweenOut.Completed:Wait()
            notif:Destroy()
        end
    end)
end

